# ==============================================================================
# Environment Configuration Template
# Attendance Management System
# ==============================================================================

# Database Configuration (Docker service hostname: mongodb)
MONGO_URI=mongodb://mongodb:27017
MONGO_DB=attendance_db
MONGODB_URI=mongodb://mongodb:27017
MONGODB_DATABASE=attendance_db

# Security & JWT Authentication
JWT_SECRET_KEY=change-this-in-development-minimum-32-characters-required
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Company Policy & Timezone
COMPANY_TIMEZONE=Asia/Kolkata
POLICY_REQUIRED_DAYS=3
POLICY_REQUIRED_HOURS=15

# Email & Notification Provider (mock | smtp | sendgrid)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=attendance-alerts@company.com
EMAIL_FROM_NAME=Attendance Management System

# SendGrid (if EMAIL_PROVIDER=sendgrid)
SENDGRID_API_KEY=

# Background Scheduler
SCHEDULER_ENABLED=false
ATTENDANCE_CHECK_SCHEDULE=0 2 * * 1

# Frontend Configuration (Browser-accessible URL)
VITE_API_BASE_URL=http://localhost:8000/api/v1

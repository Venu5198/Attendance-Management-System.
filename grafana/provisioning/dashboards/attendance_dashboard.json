      },
      "title": "Error Rate (4xx / 5xx)",
      "type": "stat",
      "targets": [
        {
          "expr": "((sum(rate(http_requests_total{status_code=~\"[45].*\"}[5m])) / (sum(rate(http_requests_total[5m])) > 0)) * 100) or vector(0)",

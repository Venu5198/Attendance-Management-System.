# Application
PROJECT_NAME="Centralized Attendance Management System"
ENVIRONMENT="development"
DEBUG=false
API_V1_PREFIX="/api/v1"

# Database
# For local development with existing docker mongo: mongodb://localhost:27018
# For docker compose: mongodb://mongodb:27017
MONGODB_URI="mongodb://localhost:27018"
MONGODB_DATABASE="attendance_db"

# Security & JWT
JWT_SECRET_KEY="replace-this-with-a-secure-random-secret-key-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Timezone & Attendance Policy
COMPANY_TIMEZONE="Asia/Kolkata"
POLICY_REQUIRED_DAYS=3
POLICY_REQUIRED_HOURS=15.0

# Email Provider Configuration
# Options: "mock", "smtp", "sendgrid"
EMAIL_PROVIDER="mock"
EMAIL_FROM="attendance-alerts@company.com"

# SMTP Settings (when EMAIL_PROVIDER="smtp")
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_USE_TLS=true

# SendGrid Settings (when EMAIL_PROVIDER="sendgrid")
SENDGRID_API_KEY=""

# Scheduler Configuration (Cron format or interval)
SCHEDULER_ENABLED=true
ATTENDANCE_CHECK_SCHEDULE="0 2 * * 1"
